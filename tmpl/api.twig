{% extends 'layout.twig' %}

{% block contents %}
    <h1>API</h1>

    <div class="bg-light p-5 rounded">
        <p>
            This skeleton provides a JSON API example. Reading posts is public.
            Creating and deleting posts requires an authenticated administrative session.
        </p>
        <p>
            Sign in through the login form and preserve the session cookie for POST and DELETE.
            Send JSON with <code>Content-Type: application/json</code>.
            Authenticated mutations also require <code>X-CSRF-Token</code> from the
            <code>csrf-token</code> meta tag. When <code>SESSION_ORIGIN</code> is nonempty, an
            <code>Origin</code> matching it is also required. Same-origin browser requests supply Origin automatically;
            non-browser clients must send it explicitly when validation is enabled.
        </p>

        <h2 class="mt-4">
            API Routes
        </h2>

        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th scope="col">Method</th>
                        <th scope="col">Path</th>
					    <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            GET
                        </td>

					    <td>
                            <a href="{{ url_for('apiPostGetAll') }}">{{ url_for('apiPostGetAll') }}</a>
                        </td>
					    <td>
                            Get All posts
                        </td>
                    </tr>
                    <tr>
                        <td>
                            GET
                        </td>

					    <td>
                            {{ url_for('apiPostGetAll') }}/{id}
                        </td>
					    <td>
                            Get a post identified by is id
                        </td>
                    </tr>
                    <tr>
                        <td>
                            POST
                        </td>

					    <td>
                            {{ url_for('apiPostGetAll') }}
                        </td>
					    <td>
                            Add a post, JSON body must be:<br>
						    <pre>{
  "title": "Blog Title",
  "content": "Blog content."
}
                            </pre>
                        </td>
                    </tr>
                    <tr>
					    <td>
                            DELETE
                        </td>

					    <td>
                            {{ url_for('apiPostGetAll') }}/{id}
                        </td>
					    <td>
                            Delete a post identified by is id
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
