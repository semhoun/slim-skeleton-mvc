{% extends 'layout.twig' %}

{% block contents %}
    <h1>Administration</h1>

    <h2>Database selection</h2>
    <form id="database-form">
        <div class="mb-3">
            <select class="form-select" id="database">
                <option value="">Loading...</option>
            </select>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Show</button>
        </div>
    </form>

    <h2 id='database_title'></h2>
    <table class="table table-bordered" id="table">
    </table>
{% endblock %}


{% block scripts %}
    <script >
     $(function() {
         $.ajax({
             url: "{{ url_for('adminDatabasesInfo') }}"
         })
          .done(function(data) {
              const select = $('#database').empty().append(new Option('Choose...', ''));
              for (let i = 0; i < data.length; i++) {
                  select.append(new Option(data[i]['title'], data[i]['id']));
              }
          });

         $('#database').on("shown.bs.select",
                           function(e, clickedIndex, newValue, oldValue) {
                               console.log(this.value, clickedIndex, newValue, oldValue)
         });

         $('#database-form').submit(function (e) {
             e.preventDefault();

             $.ajax({
                 url: "{{ url_for('admin') }}/database/" + encodeURIComponent($('#database').val())
             })
              .done(function(data) {
                  $('#table').bootstrapTable('destroy');
                  $('#database_title').text(data['title']);
                  for (const column of data.columns) {
                      if (column.field === 'action') {
                          column.formatter = function(value, row) {
                              const href = "{{ url_for('blog', {id: 0})|e('js') }}".replace(/0$/, encodeURIComponent(String(row.id)));
                              return $('<a>', {href: href, text: 'View'}).prop('outerHTML');
                          };
                      }
                  }
                  $('#table').bootstrapTable({...data, escape: true});
              });
         });
     });
    </script>
{% endblock %}
