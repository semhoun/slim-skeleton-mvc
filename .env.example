APP_ENV=dev
DEBUG_MODE=true
# Leave explicitly empty to disable Origin validation; CSRF remains mandatory.
SESSION_ORIGIN=http://localhost:8080
# Generate a unique secret of at least 32 bytes before starting the application.
SESSION_SIGNING_KEY=
TRUSTED_PROXIES=
DOCKER_MODE=false
DISABLE_TRACY_BAR=false
# Requires DEBUG_MODE=true. Use only on a protected development network:
# profiles at /_tracy/api are unauthenticated, shared, and may contain sensitive SQL.
TRACY_API_PROFILER=false
