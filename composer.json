{
  "name": "semhoun/slim-skeleton-mvc",
  "description": "Simple Slim Framework 4 skeleton with Twig, Monolog, Doctrine in Sqlite.",
  "license": "MIT",
  "type": "project",
  "keywords": [
    "slim-framework",
    "skeleton",
    "mvc",
    "sqlite",
    "twig",
    "monolog",
    "doctrine",
    "console",
    "api"
  ],
  "authors": [
    {
      "name": "Nathanael Semhoun",
      "email": "nathanael@semhoun.net",
      "homepage": "http://www.semhoun.net"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.5",
    "ext-sqlite3": "*",
    "ext-json": "*",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.8",
    "doctrine/orm": "^3.5",
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "symfony/cache": "^7.4",
    "symfony/var-exporter": "^7.4",
    "php-di/slim-bridge": "^3.4",
    "monolog/monolog": "^3.9",
    "symfony/console": "^6.4",
    "slim/twig-view": "^3.4",
    "akrabat/proxy-detection-middleware": "^1.1",
    "odan/session": "^6.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "nunomaduro/phpinsights": "^2.13",
    "rector/rector": "^2.2",
    "semhoun/slim-tracy": "^1.1",
    "phpunit/phpunit": "^10"
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public public/index.php",
    "test": "phpunit",
    "rector-fix": "rector process",
    "insights-check": "phpinsights --config-path=./phpinsights.php",
    "insights-fix": "phpinsights --config-path=./phpinsights.php -- fix",
    "pre-commit": "find . \\( -name '*.php' -o -name '*.css' -o -name '*.js' -o -name '*.twig' \\) ! -path './vendor/*' ! -path './var/*' -print0 | xargs -0 dos2unix -l -k -q -s && composer insights-fix && composer rector-fix"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
